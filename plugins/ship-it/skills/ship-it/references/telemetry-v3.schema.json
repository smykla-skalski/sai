{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smykla-skalski/sai/ship-it/telemetry/v3",
  "title": "ship-it workflow telemetry event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "emitted_at",
    "run_id",
    "task_id",
    "event",
    "harness",
    "provider",
    "model",
    "role",
    "phase",
    "observation_id",
    "worker_id",
    "wait_kind",
    "metrics",
    "outcome"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "event_id": {"type": "string", "pattern": "^evt_[0-9a-f]{24}$"},
    "emitted_at": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{24}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"},
    "event": {"enum": ["run_started", "phase_started", "phase_completed", "wait_started", "wait_completed", "user_interruption", "run_finished"]},
    "harness": {"$ref": "#/$defs/identifier"},
    "provider": {"$ref": "#/$defs/identifier"},
    "model": {"$ref": "#/$defs/identifier"},
    "role": {"enum": ["primary", "subagent", "validator", "guardian", "synthetic", "probe"]},
    "phase": {"enum": ["resolve", "orchestrate", "explore", "branch", "implement", "publish", "review", "test", "pr", "wait", "fix", "merge", "complete"]},
    "observation_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"},
    "worker_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"},
    "wait_kind": {"type": ["string", "null"], "enum": ["approval", "hosted_service", "resource_queue", null]},
    "metrics": {
      "type": "object",
      "required": ["turns", "tool_calls", "permission_decisions", "compactions", "input_tokens", "output_tokens", "elapsed_ms", "retries", "findings", "checks", "human_interventions", "failed_commands", "approval_wait_ms", "ci_failures", "ci_recurrences", "ci_resolutions", "review_cycles", "test_runs", "full_quality_gate_runs", "user_interruptions"],
      "properties": {
        "turns": {"$ref": "#/$defs/counter"},
        "tool_calls": {"$ref": "#/$defs/counter"},
        "permission_decisions": {"$ref": "#/$defs/counter"},
        "compactions": {"$ref": "#/$defs/counter"},
        "input_tokens": {"$ref": "#/$defs/counter"},
        "output_tokens": {"$ref": "#/$defs/counter"},
        "elapsed_ms": {"$ref": "#/$defs/counter"},
        "retries": {"$ref": "#/$defs/counter"},
        "findings": {"$ref": "#/$defs/counter"},
        "checks": {"$ref": "#/$defs/counter"},
        "human_interventions": {"$ref": "#/$defs/counter"},
        "failed_commands": {"$ref": "#/$defs/counter"},
        "approval_wait_ms": {"$ref": "#/$defs/counter"},
        "ci_failures": {"$ref": "#/$defs/counter"},
        "ci_recurrences": {"$ref": "#/$defs/counter"},
        "ci_resolutions": {"$ref": "#/$defs/counter"},
        "review_cycles": {"$ref": "#/$defs/counter"},
        "test_runs": {"$ref": "#/$defs/counter"},
        "full_quality_gate_runs": {"$ref": "#/$defs/counter"},
        "user_interruptions": {"$ref": "#/$defs/counter"}
      },
      "additionalProperties": false
    },
    "outcome": {"type": ["string", "null"], "enum": ["accepted", "rejected", "blocked", "cancelled", "failed", null]}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^(?!.*://)[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$"},
    "counter": {"type": ["integer", "null"], "minimum": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"event": {"const": "run_started"}}},
      "then": {"properties": {"phase": {"const": "resolve"}, "observation_id": {"const": "run"}, "worker_id": {"type": "null"}, "wait_kind": {"type": "null"}, "outcome": {"type": "null"}}}
    },
    {
      "if": {"properties": {"event": {"enum": ["phase_started", "phase_completed", "user_interruption"]}}},
      "then": {"properties": {"wait_kind": {"type": "null"}, "outcome": {"type": "null"}}}
    },
    {
      "if": {"properties": {"event": {"enum": ["phase_started", "user_interruption"]}}},
      "then": {"properties": {"observation_id": {"type": "string"}}}
    },
    {
      "if": {"properties": {"event": {"enum": ["wait_started", "wait_completed"]}}},
      "then": {"properties": {"observation_id": {"type": "string"}, "wait_kind": {"enum": ["approval", "hosted_service", "resource_queue"]}, "outcome": {"type": "null"}}}
    },
    {
      "if": {"properties": {"event": {"const": "run_finished"}}},
      "then": {
        "properties": {
          "phase": {"const": "complete"},
          "observation_id": {"const": "run"},
          "worker_id": {"type": "null"},
          "wait_kind": {"type": "null"},
          "outcome": {"enum": ["accepted", "rejected", "blocked", "cancelled", "failed"]}
        }
      }
    }
  ],
  "additionalProperties": false
}
