{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smykla-skalski/sai/ship-it/replay-trace/v1",
  "title": "ship-it workflow failure replay trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "harness", "outcome", "events", "cost"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"$ref": "#/$defs/slug"},
    "harness": {"enum": ["claude-code", "codex", "opencode", "copilot-cli", "sail"]},
    "outcome": {"enum": ["accepted", "rejected", "blocked", "cancelled", "failed", "waiting"]},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "phase", "observation"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "phase": {"enum": ["resolve", "orchestrate", "explore", "branch", "implement", "publish", "review", "test", "pr", "wait", "fix", "merge", "complete"]},
          "observation": {"$ref": "#/$defs/slug"}
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turns", "tool_calls", "permission_decisions", "input_tokens", "output_tokens", "elapsed_ms", "retries"],
      "properties": {
        "turns": {"$ref": "#/$defs/counter"},
        "tool_calls": {"$ref": "#/$defs/counter"},
        "permission_decisions": {"$ref": "#/$defs/counter"},
        "input_tokens": {"$ref": "#/$defs/counter"},
        "output_tokens": {"$ref": "#/$defs/counter"},
        "elapsed_ms": {"$ref": "#/$defs/counter"},
        "retries": {"$ref": "#/$defs/counter"}
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"},
    "counter": {"type": ["integer", "null"], "minimum": 0}
  }
}
