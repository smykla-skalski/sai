{
  "schema_version": "sai.ship-it.capabilities/v1",
  "profiles": {
    "explore": {
      "description": "Resolve and inspect without changing repository state; maintain a GitHub claim only when required.",
      "allows": [
        "filesystem.read",
        "git.read",
        "github.read",
        "github.write",
        "issue.read",
        "issue.write",
        "mcp.jira.read",
        "network.read",
        "network.write",
        "process.jira.read",
        "process.read",
        "state.write"
      ]
    },
    "build": {
      "description": "Create a branch and change, validate, and commit repository content.",
      "allows": [
        "filesystem.read",
        "filesystem.write",
        "git.read",
        "git.write",
        "github.read",
        "github.write",
        "issue.read",
        "issue.write",
        "network.read",
        "network.write",
        "process.execute",
        "process.read",
        "state.write"
      ]
    },
    "review": {
      "description": "Inspect and exercise a committed revision without changing product source.",
      "allows": [
        "filesystem.read",
        "filesystem.transient-write",
        "git.read",
        "github.read",
        "github.write",
        "issue.read",
        "issue.write",
        "network.read",
        "network.write",
        "process.execute",
        "process.read",
        "inline.review",
        "inline.test",
        "skill.review",
        "skill.test",
        "state.write",
        "subagent.review",
        "subagent.test"
      ]
    },
    "release": {
      "description": "Publish, review, merge, and close already validated work.",
      "allows": [
        "filesystem.read",
        "filesystem.transient-write",
        "filesystem.write",
        "git.read",
        "git.write",
        "github.read",
        "github.write",
        "issue.read",
        "issue.write",
        "merge.execute",
        "mcp.jira.read",
        "network.read",
        "network.write",
        "process.execute",
        "process.jira.read",
        "process.read",
        "inline.review",
        "inline.test",
        "skill.review",
        "skill.test",
        "state.write",
        "subagent.worker",
        "subagent.review",
        "subagent.test"
      ]
    }
  },
  "phases": [
    {
      "id": "resolve",
      "profile": "explore",
      "profile_overrides": [
        {"profile": "release", "when": {"fact": "create_issue", "equals": true}},
        {"profile": "release", "when": {"fact": "coordinator", "equals": true}}
      ],
      "requirements": [
        {"all_of": ["filesystem.read", "process.read", "state.write"]},
        {"all_of": ["github.read", "github.write", "issue.read", "issue.write", "network.read", "network.write"], "when": {"fact": "github_source", "equals": true}},
        {"all_of": ["github.read", "github.write", "issue.read", "issue.write", "network.read", "network.write"], "when": {"fact": "create_issue", "equals": true}},
        {"all_of": ["filesystem.write", "git.read", "git.write", "github.read", "github.write", "issue.read", "issue.write", "network.read", "network.write", "process.execute", "subagent.worker", "subagent.review", "subagent.test"], "when": {"fact": "coordinator", "equals": true}},
        {"any_of": ["mcp.jira.read", "process.jira.read"], "when": {"fact": "jira_source", "equals": true}, "fallback": "request-ticket-paste"}
      ],
      "side_effects": ["create a requested GitHub issue", "create, renew or reconcile a GitHub work claim", "create or update the task checkpoint", "coordinate an issue graph and launch isolated workers"]
    },
    {
      "id": "explore",
      "profile": "explore",
      "requirements": [
        {"all_of": ["filesystem.read", "git.read", "process.read", "state.write"]},
        {"all_of": ["github.read", "github.write", "issue.read", "issue.write", "network.read", "network.write"], "when": {"fact": "github_source", "equals": true}},
        {"all_of": ["github.read", "network.read"], "when": {"fact": "inspect_remote_work", "equals": true}}
      ],
      "side_effects": ["renew or reconcile a GitHub work claim", "update the task checkpoint"]
    },
    {
      "id": "branch",
      "profile": "build",
      "requirements": [
        {"all_of": ["filesystem.read", "filesystem.write", "git.read", "git.write", "network.read", "process.execute", "state.write"]},
        {"all_of": ["github.read", "github.write", "issue.read", "issue.write", "network.read", "network.write"], "when": {"fact": "github_source", "equals": true}}
      ],
      "side_effects": ["renew or reconcile a GitHub work claim", "fetch remote refs", "create a branch or worktree", "update the task checkpoint"]
    },
    {
      "id": "implement",
      "profile": "build",
      "requirements": [
        {"all_of": ["filesystem.read", "filesystem.write", "git.read", "git.write", "process.execute", "state.write"]},
        {"all_of": ["github.read", "github.write", "issue.read", "issue.write", "network.read", "network.write"], "when": {"fact": "github_source", "equals": true}}
      ],
      "side_effects": ["renew or reconcile a GitHub work claim", "edit repository files", "run repository commands", "create signed commits", "update the task checkpoint"]
    },
    {
      "id": "publish",
      "profile": "release",
      "requirements": [
        {"all_of": ["filesystem.read", "git.read", "git.write", "github.read", "github.write", "network.read", "network.write", "process.execute", "state.write"]},
        {"all_of": ["issue.read", "issue.write"], "when": {"fact": "github_issue_tracking", "equals": true}}
      ],
      "side_effects": ["renew or reconcile a GitHub work claim", "push committed work", "create a draft pull request", "update the task checkpoint"]
    },
    {
      "id": "review",
      "profile": "review",
      "requirements": [
        {"all_of": ["filesystem.read", "git.read", "process.read", "state.write"]},
        {"all_of": ["github.read", "github.write", "issue.read", "issue.write", "network.read", "network.write"], "when": {"fact": "github_source", "equals": true}},
        {"any_of": ["skill.review", "subagent.review"], "when": {"fact": "review_gate_required", "equals": true}, "fallback": "portable-review-fallback"},
        {"all_of": ["subagent.review"], "when": {"all": [{"fact": "review_gate_required", "equals": true}, {"fact": "sail", "equals": true}]}}
      ],
      "side_effects": ["renew or reconcile a GitHub work claim", "write bounded review state outside the repository", "update the task checkpoint"]
    },
    {
      "id": "test",
      "profile": "review",
      "requirements": [
        {"all_of": ["filesystem.read", "git.read", "state.write"]},
        {"all_of": ["github.read", "github.write", "issue.read", "issue.write", "network.read", "network.write"], "when": {"fact": "github_source", "equals": true}},
        {"all_of": ["filesystem.transient-write", "process.execute"], "when": {"fact": "test_gate_required", "equals": true}},
        {"any_of": ["skill.test", "subagent.test"], "when": {"fact": "test_gate_required", "equals": true}, "fallback": "portable-test-fallback"},
        {"all_of": ["subagent.test"], "when": {"all": [{"fact": "test_gate_required", "equals": true}, {"fact": "sail", "equals": true}]}}
      ],
      "side_effects": ["renew or reconcile a GitHub work claim", "run the product in isolated state", "write temporary test state outside the repository", "update the task checkpoint"]
    },
    {
      "id": "pr-loop",
      "profile": "release",
      "requirements": [
        {"all_of": ["filesystem.read", "filesystem.write", "git.read", "git.write", "github.read", "github.write", "merge.execute", "network.read", "network.write", "process.execute", "state.write"]},
        {"all_of": ["github.read", "github.write", "issue.read", "issue.write", "network.read", "network.write"], "when": {"fact": "github_source", "equals": true}},
        {"any_of": ["skill.review", "subagent.review"], "when": {"all": [{"fact": "code_changed", "equals": true}, {"fact": "review_gate_required", "equals": true}]}, "fallback": "portable-review-fallback"},
        {"any_of": ["skill.test", "subagent.test"], "when": {"all": [{"fact": "code_changed", "equals": true}, {"fact": "test_gate_required", "equals": true}]}, "fallback": "portable-test-fallback"},
        {"all_of": ["subagent.review"], "when": {"all": [{"fact": "code_changed", "equals": true}, {"fact": "review_gate_required", "equals": true}, {"fact": "sail", "equals": true}]}},
        {"all_of": ["subagent.test"], "when": {"all": [{"fact": "code_changed", "equals": true}, {"fact": "test_gate_required", "equals": true}, {"fact": "sail", "equals": true}]}},
        {"all_of": ["issue.write"], "when": {"fact": "github_issue_tracking", "equals": true}}
      ],
      "side_effects": ["push commits", "create or update a pull request", "request review", "merge", "update a GitHub issue", "update the task checkpoint"]
    },
    {
      "id": "complete",
      "profile": "release",
      "requirements": [
        {"all_of": ["filesystem.read", "git.read", "github.read", "network.read", "process.read", "state.write"]},
        {"all_of": ["github.write", "issue.read", "issue.write", "network.write"], "when": {"fact": "github_issue_tracking", "equals": true}},
        {"all_of": ["filesystem.write", "git.write", "process.execute"], "when": {"fact": "owns_cleanup", "equals": true}}
      ],
      "side_effects": ["comment on and close a tracked GitHub issue when automatic closure failed", "record the final task checkpoint", "remove the task worktree when owned and safe"]
    }
  ],
  "protected_actions": {
    "always_interactive": [
      "destructive filesystem or history change outside declared branch or worktree cleanup",
      "credential, secret, or private-key access",
      "deployment or production-system mutation",
      "write outside the workspace except declared task or isolated test state",
      "unknown or unclassified action"
    ],
    "never_bypass": [
      "repository hooks and checks",
      "branch protection",
      "required review or test gates",
      "repository merge policy"
    ]
  },
  "failure": {
    "preflight": "Resolve every active requirement before the phase's first side effect.",
    "status": "NEEDS_CAPABILITY",
    "report_fields": ["phase", "profile", "missing_requirement", "attempted_fallbacks", "required_user_action"]
  }
}
