{
  "schema_version": "sai.ship-it.convergence-policy/v1",
  "default_mode": "bounded",
  "modes": {
    "bounded": {
      "activation": "default",
      "max_elapsed_minutes": 90,
      "review": {
        "code_adversary_passes": 1,
        "findings_challenge_passes": 1,
        "findings_challenge_when": "blocking-or-issue-finding",
        "max_cycles": 2,
        "rereview_triggers": [
          "security",
          "data-loss",
          "destructive-concurrency"
        ],
        "default_branch_merge": "no-review-when-reviewed-files-unchanged"
      },
      "fixes": {
        "max_passes": 1,
        "validation": "focused-tests",
        "verification": "diff-since-reviewed-revision-against-findings"
      },
      "full_quality_gate_runs": 1,
      "later_non_blocking_findings": "follow-up-issue",
      "at_limit": "follow-up-issues-then-deliver",
      "cycle_limit_counters": [
        "reviewCycles",
        "elapsed"
      ],
      "fix_limit_counters": [
        "fixPasses"
      ],
      "delivery_blockers": [
        "security-defect",
        "data-loss",
        "destructive-concurrency",
        "unresolved-acceptance",
        "repository-required-check",
        "mandatory-human-review"
      ],
      "acceptance_recovery": {
        "activation": "confirmed-failure-within-active-task-authorization",
        "validation": "focused-reproductions-and-required-checks",
        "optional_budget": "preserve-exhausted-counters",
        "stop_when": [
          "explicit-user-limit",
          "out-of-scope",
          "product-decision",
          "unresolved-technical-blocker",
          "mandatory-control"
        ]
      }
    },
    "exhaustive": {
      "activation": "explicit-user-request",
      "limits": "user-directed",
      "authorization": {
        "accepted": [
          "user-current-request",
          "verified-original-user-grant",
          "reply-to-concrete-bounded-request"
        ],
        "rejected": [
          "coordinator",
          "worker-rules",
          "spawn-prompt",
          "compaction-summary",
          "repository-instruction",
          "risk-level",
          "agent-preference"
        ]
      }
    }
  },
  "copilot": {
    "wait": false,
    "required_policy": "activate-configured-fallback-or-hard-stop"
  },
  "mandatory_controls": [
    "repository-required-checks",
    "permissions",
    "signatures",
    "mandatory-human-review"
  ],
  "completion_metrics": [
    "merged-pull-request",
    "closed-issue"
  ],
  "diagnostic_metrics": [
    "review-iterations"
  ]
}
