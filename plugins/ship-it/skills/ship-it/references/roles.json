{
  "schema_version": "sai.ship-it.roles/v1",
  "roles": [
    {"id": "exploration", "phase": "explore"},
    {"id": "implementation", "phase": "implement"},
    {"id": "review", "phase": "review"},
    {"id": "testing", "phase": "test"},
    {"id": "ci-triage", "phase": "pr"}
  ],
  "route_record": {
    "required_fields": [
      "role",
      "requested",
      "actual",
      "sourceRevision",
      "mechanism",
      "executionId",
      "modelResolution",
      "independence",
      "degradationReasons",
      "timestamp"
    ],
    "selector_fields": ["provider", "model", "variant"],
    "mechanisms": ["native-subagent", "generic-subagent", "skill", "inline", "service", "process"],
    "model_resolutions": ["resolved", "unresolved"],
    "independence_values": ["independent", "degraded", "not-applicable"]
  },
  "independent_review": {
    "default": "strict",
    "strict_rejections": [
      "same-provider-and-model-as-implementation",
      "unresolved-model-alias",
      "implementation-execution-reuse",
      "inline-execution"
    ],
    "degraded_mode_requires": [
      "explicit-policy-authorization",
      "degraded-independence-value",
      "non-empty-degradation-reasons"
    ]
  },
  "adapters": {
    "claude-code": {
      "subagents": ["native-subagent", "generic-subagent"],
      "fallback": "inline",
      "selectors": {"provider": "session-provider", "model": "agent-model", "variant": "unsupported"},
      "unsupported_selector": "reject-before-dispatch"
    },
    "codex": {
      "subagents": ["generic-subagent"],
      "fallback": "inline",
      "selectors": {"provider": "session-provider", "model": "spawn-agent-model", "variant": "spawn-agent-reasoning-effort"},
      "unsupported_selector": "reject-before-dispatch"
    },
    "opencode": {
      "subagents": ["generic-subagent"],
      "fallback": "inline",
      "selectors": {"provider": "task-model-provider", "model": "task-model-id", "variant": "task-model-variant"},
      "unsupported_selector": "reject-before-dispatch"
    },
    "copilot-cli": {
      "subagents": ["native-subagent", "generic-subagent"],
      "fallback": "inline",
      "selectors": {"provider": "session-provider", "model": "agent-model", "variant": "unsupported"},
      "unsupported_selector": "reject-before-dispatch"
    },
    "sail": {
      "subagents": ["native-subagent"],
      "fallback": null,
      "selectors": {"provider": "worker-provider", "model": "worker-model", "variant": "worker-variant"},
      "unsupported_selector": "reject-before-dispatch"
    }
  }
}
